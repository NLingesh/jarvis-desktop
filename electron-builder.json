{
  "appId": "com.jarvis.desktop",
  "productName": "JARVIS",
  "artifactName": "Jarvis-${version}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraFiles": [
    {
      "from": "venv/",
      "to": "venv",
      "filter": ["**/*"]
    },
    {
      "from": "jarvis_backend/",
      "to": "jarvis_backend",
      "filter": [
        "**/*",
        "!**/__pycache__/**",
        "!**/*.pyc",
        "!**/*.log",
        "!.env",
        "!**/.env.example",
        "!**/pytest.ini",
        "!**/*.db",
        "!**/*.db-journal",
        "!**/*.sqlite",
        "!**/*.md"
      ]
    },
    {
      "from": "jarvis_frontend/dist/",
      "to": "jarvis_frontend/dist",
      "filter": ["**/*"]
    },
    {
      "from": "build/icons/",
      "to": "build/icons",
      "filter": ["**/*"]
    }
  ],
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Utility",
    "icon": "build/icons/icon-512.png",
    "maintainer": "JARVIS Team <noreply@jarvis.app>",
    "synopsis": "Voice-first AI Assistant",
    "description": "JARVIS is a personal AI desktop companion with voice control, file management, and system integration."
  },
  "mac": {
    "category": "public.app-category.utilities",
    "icon": "build/icons/icon-512.png"
  },
  "win": {
    "icon": "build/icons/icon-512.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "compression": "maximum",
  "asar": true,
  "afterPack": "./scripts/fix-fuse-after-pack.js",
  "publish": {
    "provider": "github",
    "owner": "NLingesh",
    "repo": "jarvis-desktop"
  }
}
