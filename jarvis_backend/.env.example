# LLM Configuration (Primary: Mistral, Fallback: Anthropic)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistralai/mistral-nemotron
MISTRAL_API_URL=https://api.mistral.ai

# Anthropic API (fallback if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# NVIDIA Reranking (optional)
NVIDIA_API_KEY=your-nvidia-api-key-here
# Or use full auth header if needed:
# NVIDIA_API_AUTH_HEADER=Bearer your_token_here
NVIDIA_RERANK_MODEL=nv-rerank-qa-mistral-4b:1
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/reranking

NVIDIA_NEMOTRON_MODEL=nemotron-3.5-lightning-30b-a3b
NEMOTRON_API_KEY=your-nemotron-api-key-here
NEMOTRON_API_URL=https://integrate.api.nvidia.com/v1
# ElevenLabs API (optional fallback when Kokoro is unavailable, or primary if
# TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# Optional: override the voice ID and model (defaults shown)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# TTS provider selection (default: kokoro — fully local, no key required)
# TTS_PROVIDER=kokoro
# TTS_PROVIDER=elevenlabs
# Kokoro voice (local). See the Kokoro README for valid voice names.
# KOKORO_VOICE=af_heart
# Optional path to a local Kokoro-82M model directory (downloads to the Hugging
# Face cache automatically if unset).
# KOKORO_MODEL_PATH=

# Microsoft Edge TTS voice (keyless fallback when the above are unavailable)
EDGE_TTS_VOICE=en-US-GuyNeural

# Offline speech-to-text (voice input in Electron). Downloads with
# scripts/download-vosk-model.sh. Uses ~/Documents/jarvis or DOCUMENTS_ROOT.
VOSK_MODEL_DIR=

# Email configuration
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Server configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=False

# CORS - allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Calendar integration
CALENDAR_TYPE=evolution

# Database
DATABASE_PATH=jarvis_memory.db

# Documents
# Root folder for JARVIS document operations. All reads/writes are restricted to this folder.
DOCUMENTS_ROOT=~/Documents/jarvis
# Allowed document extensions for read/write operations
ALLOWED_DOCUMENT_EXTENSIONS=.txt,.md,.csv,.docx,.pdf
ALLOWED_WRITE_EXTENSIONS=.txt,.md,.docx

# Logging
LOG_LEVEL=INFO

# Authentication (optional, off by default)
# When JARVIS_AUTH_ENABLED=true, every /api/* endpoint (except /api/auth/login
# and /api/auth/register) requires `Authorization: Bearer <token>` obtained from
# POST /api/auth/login. The WebSocket requires an `access_token` query param.
# Set JARVIS_AUTH_USERNAME/PASSWORD to auto-create a bootstrap user at startup.
JARVIS_AUTH_ENABLED=false
JARVIS_AUTH_TTL_HOURS=24
# JARVIS_AUTH_USERNAME=
# JARVIS_AUTH_PASSWORD=

# Memory Vault
# Root folder of the Obsidian-compatible Markdown memory vault. All notes are
# plain .md files here; open this folder in Obsidian to browse/edit them.
# Defaults to ~/Documents/JARVIS Memory.
# MEMORY_VAULT_PATH=~/Documents/JARVIS Memory
# Search backend: fts (default, SQLite FTS5) or scan (no index, linear scans).
VAULT_SEARCH_BACKEND=fts